{
  "name": "liberusoftware/module-social-network-notifications-filament",
  "description": "Filament adapter for Notifications.",
  "type": "liberu-module",
  "license": "MIT",
  "version": "0.1.2",
  "require": {
    "php": "^8.5",
    "filament/filament": "^5.1",
    "liberusoftware/module-social-network-notifications": "^0.1",
    "liberusoftware/module-social-network-profiles": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\SocialNetwork\\Notifications\\Filament\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "social-network-notifications-filament"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "test:unit": "pest tests/Unit",
    "test:feature": "pest tests/Feature",
    "test:coverage": "pest --coverage --min=100 --coverage-clover=coverage.xml",
    "test:parallel": "pest --parallel"
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
