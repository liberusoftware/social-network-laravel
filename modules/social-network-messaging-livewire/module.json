{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-messaging-livewire",
  "display_name": "Social Network Messaging Livewire",
  "description": "Livewire message composer.",
  "version": "0.1.2",
  "category": "presentation",
  "provider": "Liberu\\SocialNetwork\\Messaging\\Livewire\\MessagingLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-messaging": "^0.1",
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "presentation": {
    "livewire": [
      "composer",
      "conversations",
      "messages"
    ]
  },
  "capabilities": [
    "social-network.messaging.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Message composition",
    "Conversation state",
    "Message state",
    "Validation feedback"
  ]
}
