{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-messaging",
  "display_name": "Social Network Messaging",
  "description": "Private messaging domain and lifecycle.",
  "version": "0.1.2",
  "category": "product",
  "provider": "Liberu\\SocialNetwork\\Messaging\\MessagingServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "capabilities": [
    "social-network.messaging"
  ],
  "features": [
    "Conversations",
    "Membership",
    "Delivery and read state",
    "Attachments",
    "Unread counts",
    "Requests",
    "Safety",
    "Retention"
  ],
  "default_enabled": true
}
