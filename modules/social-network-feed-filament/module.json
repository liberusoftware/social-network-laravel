{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-feed-filament",
  "display_name": "Social Network Feed Filament",
  "description": "Filament feed administration.",
  "version": "0.1.2",
  "category": "presentation",
  "provider": "Liberu\\SocialNetwork\\Feed\\Filament\\FeedFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-feed": "^0.1",
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "presentation": {
    "filament": {
      "app": [
        "Liberu\\SocialNetwork\\Feed\\Filament\\FeedFilamentPlugin"
      ]
    }
  },
  "capabilities": [
    "social-network.feed.filament"
  ],
  "default_enabled": true,
  "features": [
    "Feed review"
  ]
}
