{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-social-graph",
  "display_name": "Social Network Social Graph",
  "description": "Follows, friendship requests, lists, suggestions, blocks, and relationship visibility.",
  "version": "0.1.2",
  "category": "product",
  "provider": "Liberu\\SocialNetwork\\SocialGraph\\SocialGraphServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "capabilities": [
    "social-network.social-graph"
  ],
  "features": [
    "Follows",
    "Friendship requests",
    "Lists",
    "Suggestions",
    "Blocks",
    "Relationship visibility"
  ],
  "default_enabled": true
}
