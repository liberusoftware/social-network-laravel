{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-media-livewire",
  "display_name": "Social Network Media Livewire",
  "description": "Livewire media registration interaction.",
  "version": "0.1.2",
  "category": "presentation",
  "provider": "Liberu\\SocialNetwork\\Media\\Livewire\\MediaLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-media": "^0.1",
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "presentation": {
    "livewire": [
      "social-media-register"
    ]
  },
  "capabilities": [
    "social-network.media.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Asset registration",
    "Alt text feedback"
  ]
}
