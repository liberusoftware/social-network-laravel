{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-social-graph-livewire",
  "display_name": "Social Network Social Graph Livewire",
  "description": "Livewire relationship interaction.",
  "version": "0.1.2",
  "category": "presentation",
  "provider": "Liberu\\SocialNetwork\\SocialGraph\\Livewire\\SocialGraphLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-social-graph": "^0.1",
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "presentation": {
    "livewire": [
      "follow-profile",
      "follow-friend-models",
      "requests",
      "block-profile",
      "lists",
      "suggestions",
      "relationship-visibility"
    ]
  },
  "capabilities": [
    "social-network.social-graph.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Follow interaction",
    "Friend requests",
    "Blocks",
    "Lists",
    "Suggestions",
    "Relationship visibility",
    "Validation feedback"
  ]
}
