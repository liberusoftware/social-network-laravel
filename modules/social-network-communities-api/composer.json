{
  "name": "liberusoftware/module-social-network-communities-api",
  "description": "Versioned API adapter for Communities.",
  "type": "liberu-module",
  "license": "MIT",
  "version": "0.1.0",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "laravel/sanctum": "^4.0",
    "liberusoftware/module-social-network-communities": "^0.1",
    "liberusoftware/module-social-network-profiles": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\SocialNetwork\\Communities\\Api\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "social-network-communities-api"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "test:unit": "pest tests/Unit",
    "test:feature": "pest tests/Feature",
    "test:coverage": "pest --coverage --min=100 --coverage-clover=coverage.xml",
    "test:parallel": "pest --parallel"
  }
}
