{
  "name": "liberusoftware/module-social-network-engagement",
  "description": "Reactions, comments, replies, sharing, bookmarks, counters, and abuse limits.",
  "type": "liberu-module",
  "license": "MIT",
  "version": "0.1.1",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/events": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-social-network-profiles": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\SocialNetwork\\Engagement\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "social-network-engagement"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "test:unit": "pest tests/Unit",
    "test:feature": "pest tests/Feature",
    "test:coverage": "pest --coverage --min=100 --coverage-clover=coverage.xml",
    "test:parallel": "pest --parallel"
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
