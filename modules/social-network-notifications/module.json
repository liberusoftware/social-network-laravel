{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-notifications",
  "display_name": "Social Network Notifications",
  "description": "User notification preferences and delivery state.",
  "version": "0.1.2",
  "category": "product",
  "provider": "Liberu\\SocialNetwork\\Notifications\\NotificationsServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "capabilities": [
    "social-network.notifications"
  ],
  "features": [
    "Preferences",
    "In-app, email, and push delivery",
    "Grouping",
    "Digests",
    "Quiet hours",
    "Read state"
  ],
  "default_enabled": true
}
