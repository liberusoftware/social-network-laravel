{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-publishing-livewire",
  "display_name": "Social Network Publishing Livewire",
  "description": "Livewire publication composer.",
  "version": "0.1.2",
  "category": "presentation",
  "provider": "Liberu\\SocialNetwork\\Publishing\\Livewire\\PublishingLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-publishing": "^0.1",
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "presentation": {
    "livewire": [
      "social-publishing-composer"
    ]
  },
  "capabilities": [
    "social-network.publishing.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Draft composition",
    "Validation feedback"
  ]
