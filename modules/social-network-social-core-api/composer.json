{
  "name": "liberusoftware/module-social-network-social-core-api",
  "description": "Versioned API adapter for Liberu Social Network Social Core.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-social-network-social-core": "^0.1",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {"psr-4": {"Liberu\\SocialNetwork\\SocialCore\\Api\\": "src/"}},
