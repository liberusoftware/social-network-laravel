{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "social-network-messaging-filament",
  "display_name": "Social Network Messaging Filament",
  "description": "Filament messaging administration.",
  "version": "0.1.2",
  "category": "presentation",
  "provider": "Liberu\\SocialNetwork\\Messaging\\Filament\\MessagingFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-social-network-messaging": "^0.1",
      "liberusoftware/module-social-network-profiles": "^0.1"
    }
  },
  "presentation": {
    "filament": {
      "app": [
        "Liberu\\SocialNetwork\\Messaging\\Filament\\MessagingFilamentPlugin"
      ]
    }
  },
  "capabilities": [
    "social-network.messaging.filament"
  ],
  "default_enabled": true,
  "features": [
    "Conversation review",
    "Safety controls"
  ]
}
